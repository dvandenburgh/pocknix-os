package() {
  local _f
  for _f in "${_extrafw_files[@]}" "${_rocknix_files[@]}"; do
    install -Dm644 "${srcdir}/${_f//\//_}" "${pkgdir}/usr/lib/firmware/updates/${_f}"
  done
  # a git symlink upstream: a raw fetch returns its 18-byte target path, not the topology
  ln -s AYN-Odin2-tplg.bin "${pkgdir}/usr/lib/firmware/updates/qcom/sm8550/AYN-Thor-tplg.bin"
}
