# Retroid Pocket 6 firmware upstream linux-firmware lacks or gets wrong (ath12k WCN7850,
# ADSP/CDSP, speaker amps, audio topology, VPU). Pinned by commit + sha256, nothing in git. The
# RP6 runs its own ADSP build (extracted from a Retroid Android image) from
# qcom/sm8550/retroidpocket/rp6/; pd-mapper reads the .jsn files from the ADSP's directory, so
# they and the amp tuning sit beside it. The CDSP and the AYN-Odin2 topology (the RP6's sound
# card is named AYN-Odin2) come from the first pin, the ADSP set from the second. /usr/lib/firmware/updates/ wins the kernel's search and no ALARM package writes
# there, so linux-firmware updates never revert the ath12k board file that wifi needs.
pkgname=pocknix-firmware-sm8550
pkgver=0.1.0
pkgrel=3.2
pkgdesc="Retroid Pocket 6 vendor firmware (wifi, ADSP/CDSP, audio, VPU), immune to linux-firmware updates"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('custom:qcom-firmware')   # Qualcomm vendor blobs
# firmware blobs must ship byte-identical; some parse as ELF and strip would alter them
options=('!strip')

_extrafw=30c56e2f34af37fe372166b739d6ab277f5155b5   # ROCKNIX/extra-firmware, SM8550/
_extrafw_files=(
  ath12k/WCN7850/hw2.0/amss.bin
  ath12k/WCN7850/hw2.0/board-2.bin
  ath12k/WCN7850/hw2.0/m3.bin
  ath12k/WCN7850/hw2.0/regdb.bin
  qcom/sm8550/AYN-Odin2-tplg.bin
  qcom/sm8550/SM8550-APS-tplg.bin
  qcom/sm8550/ayn/cdsp.mbn
  qcom/sm8550/ayn/cdsp_dtb.mbn
  qcom/vpu/vpu30_p4.mbn
  renesas_usb_fw.mem
)
_armada=ce363b8e67cfd2b5fcf44fd384686f85d777ae9d   # armada-os/armada, system_files/usr/lib/firmware/
_armada_files=(
  qcom/sm8550/retroidpocket/rp6/adsp.mbn
  qcom/sm8550/retroidpocket/rp6/adsp_dtb.mbn
  qcom/sm8550/retroidpocket/rp6/adspr.jsn
  qcom/sm8550/retroidpocket/rp6/adsps.jsn
  qcom/sm8550/retroidpocket/rp6/adspua.jsn
  qcom/sm8550/retroidpocket/rp6/aw883xx_acf.bin
  qcom/sm8550/retroidpocket/rp6/battmgr.jsn
)
source=()
for _f in "${_extrafw_files[@]}"; do
  source+=("${_f//\//_}::https://raw.githubusercontent.com/ROCKNIX/extra-firmware/${_extrafw}/SM8550/${_f}")
done
for _f in "${_armada_files[@]}"; do
  source+=("${_f//\//_}::https://raw.githubusercontent.com/armada-os/armada/${_armada}/system_files/usr/lib/firmware/${_f}")
done
sha256sums=(
