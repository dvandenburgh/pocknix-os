# SM8550 family firmware upstream linux-firmware lacks or gets wrong (ath12k WCN7850, ADSP/CDSP,
# speaker amps, audio topology, VPU). Pinned by commit + sha256, nothing in git. The Thor ADSP
# pair comes from a separate pin: the build fielded Thors run, until a Thor tester validates
# the newer one. /usr/lib/firmware/updates/ wins the kernel's search and no ALARM package writes
# there, so linux-firmware updates never revert the ath12k board file that wifi needs.
pkgname=pocknix-firmware-sm8550
pkgver=0.1.0
pkgrel=3
pkgdesc="SM8550 family vendor firmware (wifi, ADSP/CDSP, audio, VPU), immune to linux-firmware updates"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('custom:qcom-firmware')   # Qualcomm vendor blobs
# firmware blobs must ship byte-identical; some parse as ELF and strip would alter them
options=('!strip')

_extrafw=30c56e2f34af37fe372166b739d6ab277f5155b5   # ROCKNIX/extra-firmware, SM8550/
_rocknix=e57806192e3f9a8522237c692820408ef4c7c6f1   # ROCKNIX/distribution, SM8550 kernel overlay
_extrafw_files=(
  ath12k/WCN7850/hw2.0/amss.bin
  ath12k/WCN7850/hw2.0/board-2.bin
  ath12k/WCN7850/hw2.0/m3.bin
  ath12k/WCN7850/hw2.0/regdb.bin
  qcom/sm8550/AYN-Odin2-tplg.bin
  qcom/sm8550/SM8550-APS-tplg.bin
  qcom/sm8550/ayn/cdsp.mbn
  qcom/sm8550/ayn/cdsp_dtb.mbn
  qcom/sm8550/ayn/odin2/adsp.mbn
  qcom/sm8550/ayn/odin2/adsp_dtb.mbn
  qcom/sm8550/ayn/odin2/adspr.jsn
  qcom/sm8550/ayn/odin2/adsps.jsn
  qcom/sm8550/ayn/odin2/adspua.jsn
  qcom/sm8550/ayn/odin2/aw883xx_acf.bin
  qcom/sm8550/ayn/odin2/battmgr.jsn
  qcom/sm8550/ayn/odin2mini/adsp.mbn
  qcom/sm8550/ayn/odin2mini/adsp_dtb.mbn
  qcom/sm8550/ayn/odin2mini/adspr.jsn
  qcom/sm8550/ayn/odin2mini/adsps.jsn
  qcom/sm8550/ayn/odin2mini/adspua.jsn
  qcom/sm8550/ayn/odin2mini/aw883xx_acf.bin
  qcom/sm8550/ayn/odin2mini/battmgr.jsn
  qcom/sm8550/ayn/odin2portal/adsp.mbn
  qcom/sm8550/ayn/odin2portal/adsp_dtb.mbn
  qcom/sm8550/ayn/odin2portal/adspr.jsn
  qcom/sm8550/ayn/odin2portal/adsps.jsn
  qcom/sm8550/ayn/odin2portal/adspua.jsn
  qcom/sm8550/ayn/odin2portal/aw883xx_acf.bin
  qcom/sm8550/ayn/odin2portal/battmgr.jsn
  qcom/sm8550/ayn/thor/adspr.jsn
  qcom/sm8550/ayn/thor/adsps.jsn
  qcom/sm8550/ayn/thor/adspua.jsn
  qcom/sm8550/ayn/thor/aw883xx_acf.bin
  qcom/sm8550/ayn/thor/battmgr.jsn
  qcom/vpu/vpu30_p4.mbn
  renesas_usb_fw.mem
)
_rocknix_files=(
  qcom/sm8550/ayn/thor/adsp.mbn
  qcom/sm8550/ayn/thor/adsp_dtb.mbn
)
source=()
for _f in "${_extrafw_files[@]}"; do
  source+=("${_f//\//_}::https://raw.githubusercontent.com/ROCKNIX/extra-firmware/${_extrafw}/SM8550/${_f}")
done
for _f in "${_rocknix_files[@]}"; do
  source+=("${_f//\//_}::https://raw.githubusercontent.com/ROCKNIX/distribution/${_rocknix}/projects/ROCKNIX/devices/SM8550/filesystem/usr/lib/kernel-overlays/base/lib/firmware/${_f}")
done
