# Unowned overlay leftovers: /usr/local wins PATH and would shadow the packaged
# /usr/bin copy forever.
_prune_superseded() {
  rm -f /usr/local/bin/pocknix-update \
        /usr/share/applications/pocknix-updater.desktop \
        /var/lib/pocknix/extra-packages \
        /var/lib/pocknix/extra-packages.snapshot
}

# Retrofits the [pocknix-shared] stanza. The URL derives from the installed [pocknix] one
# (LAN-test devices point at their own host); pacman reads its config at transaction start,
# so it goes live next transaction. The systemd guard keeps image chroots out.
_add_shared_repo() {
  [ -d /run/systemd/system ] || return 0
  local conf=/etc/pacman.conf
  grep -q '^\[pocknix-shared\]' "${conf}" && return 0
  grep -q '^\[pocknix\]' "${conf}" || return 0
  local server siglevel
  server="$(awk '/^\[pocknix\]$/{f=1;next} /^\[/{f=0} f && sub(/^Server *= */,""){print; exit}' "${conf}")"
  siglevel="$(awk '/^\[pocknix\]$/{f=1;next} /^\[/{f=0} f && sub(/^SigLevel *= */,""){print; exit}' "${conf}")"
  [ -n "${server}" ] || return 0
  server="${server%/}"; server="${server%/*}/shared"
  awk -v srv="${server}" -v sig="${siglevel}" '
    function emit() { print "[pocknix-shared]"
                      if (sig != "") print "SigLevel = " sig
                      print "Server = " srv
                      print ""
                      done=1 }
    /^\[/ { if (inpk && !done) emit(); inpk = ($0 == "[pocknix]") }
    { print }
    END { if (inpk && !done) emit() }
  ' "${conf}" > "${conf}.pocknix-shared" && cat "${conf}.pocknix-shared" > "${conf}"
  rm -f "${conf}.pocknix-shared"
  echo "pocknix: added the [pocknix-shared] repo (${server}); active from the next update."
}

# ALARM's default login (password `alarm`, wheel) is a known root credential once SSH is on.
# The home stays: a single login seeds it, so its contents cannot prove nobody moved in.
_drop_alarm_user() {
  [ -d /run/systemd/system ] || return 0
  id alarm >/dev/null 2>&1 || return 0
  if pgrep -u alarm >/dev/null 2>&1; then
    echo "pocknix: 'alarm' has running processes; it is removed on the next update instead."
    return 0
  fi
  userdel alarm >/dev/null 2>&1 \
    && echo "pocknix: removed ALARM's default 'alarm' login (its files stay in /home/alarm)."
}

# The hook only fires from the transaction AFTER it is installed.
_stamp_os_release() {
  /usr/lib/pocknix/pocknix-os-release || true
}

post_install() {
  _prune_superseded
  _add_shared_repo
  _drop_alarm_user
  _stamp_os_release
}

post_upgrade() {
  _prune_superseded
  _add_shared_repo
  _drop_alarm_user
  _stamp_os_release
}
