# pocknix-branding — Pocknix OS artwork: the plymouth boot theme, the Plasma splash, and
# the desktop wallpaper. One package so the three stay in step on the same wordmark. The
# boot theme sits on SteamOS's black field (game mode boots like a Deck); the Plasma
# splash and wallpaper keep the #202126 desktop field.
pkgname=pocknix-branding
pkgver=0.1.0
pkgrel=3
pkgdesc="Pocknix OS branding: plymouth boot theme, Plasma splash, wallpaper"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
depends=('bash')
install='pocknix-branding.install'
# The plymouth theme is DERIVED from the stock spinner at build time rather than committed:
# copying 66 animation frames into this repo would duplicate plymouth's own assets and let
# them drift. Building against the installed theme keeps the spinner in step with whatever
# plymouth version the image ships, while the OUTPUT still lands in our own directory - which
# is what makes it survive a plymouth upgrade (the reason a custom theme dir was wanted).
# librsvg: the watermark and particle frames are drawn from SVG at build time, so no rendered
# PNG is committed.
makedepends=('plymouth' 'librsvg')
source=('watermark.svg' 'logo.svg' 'throbber.svg' 'particles.awk'
        'Splash.qml' 'splash-metadata.json' 'wordmark.png'
        'wallpaper-1920x1080.png' 'wallpaper-metadata.json'
        'pocknix-branding-init' 'pocknix-branding-init.service')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

_spinner=/usr/share/plymouth/themes/spinner

build() {
  # makepkg symlinks local sources into srcdir, and librsvg refuses <image> hrefs that resolve
  # outside the referencing file's directory, so render from real copies.
  local w="${srcdir}/render" f n
  rm -rf "${w}"
  install -d "${w}"
  cp -L "${srcdir}"/{watermark.svg,logo.svg,throbber.svg,wordmark.png} "${w}/"
  rsvg-convert "${w}/watermark.svg" -o "${w}/watermark.png"
  # two-step redraws its throbber at 30 fps over a fixed 2 s loop: 60 frames, one per redraw
  awk -v frames=60 -v out="${w}" -f "${srcdir}/particles.awk"
  for f in "${w}"/particles-*.svg; do
    n="${f##*/particles-}"
    cp "${f}" "${w}/particles.svg"
    rsvg-convert "${w}/throbber.svg" -o "${w}/throbber-${n%.svg}.png"
  done
}

package() {
  # --- plymouth boot theme -------------------------------------------------------------
  [ -d "${_spinner}" ] || { echo "pocknix-branding: ${_spinner} missing (is plymouth installed?)" >&2; return 1; }
  local theme="${pkgdir}/usr/share/plymouth/themes/pocknix"
  install -d "${theme}"
  cp -a "${_spinner}/." "${theme}/"
  mv "${theme}/spinner.plymouth" "${theme}/pocknix.plymouth"
  # logo + wordmark replace the Arch watermark (sized in logical px, see watermark.svg), and the
  # orbiting particles replace the spinner's throbber frames
  install -Dm644 "${srcdir}/render/watermark.png" "${theme}/watermark.png"
  rm -f "${theme}"/throbber-*.png
  install -m644 "${srcdir}"/render/throbber-*.png "${theme}/"

  # Name/Description/ImageDir point at OUR dir; black field and white mark follow SteamOS's boot
  # screen. two-step tops the watermark at a(H-h) but centres the throbber on aH, so a = 13/32 gives
  # the 256-high watermark and the 208-high throbber one top on any screen (256a = 208/2).
  # Messages move to the corner, off the wordmark; pocknix-steam-splash reads the field back.
  sed -i -e '/^Name\[[^]]*\]=/d' \
         -e 's|^Name=.*|Name=Pocknix|' \
         -e 's|^Description=.*|Description=Pocknix OS boot splash: the Pocknix logo, its protons and electrons orbiting while it boots.|' \
         -e "s|^ImageDir=.*|ImageDir=/usr/share/plymouth/themes/pocknix|" \
         -e 's|^BackgroundStartColor=.*|BackgroundStartColor=0x000000|' \
         -e 's|^BackgroundEndColor=.*|BackgroundEndColor=0x000000|' \
         -e 's|^WatermarkVerticalAlignment=.*|WatermarkVerticalAlignment=.40625|' \
         -e 's|^VerticalAlignment=.*|VerticalAlignment=.40625|' \
         -e 's|^MessageBelowAnimation=.*|MessageBelowAnimation=false|' \
         "${theme}/pocknix.plymouth"

  # --- Plasma splash (KSplash look-and-feel) -------------------------------------------
  local splash="${pkgdir}/usr/share/plasma/look-and-feel/com.pocknix.splash"
  install -Dm644 "${srcdir}/splash-metadata.json" "${splash}/metadata.json"
  install -Dm644 "${srcdir}/Splash.qml"           "${splash}/contents/splash/Splash.qml"
  install -Dm644 "${srcdir}/wordmark.png"         "${splash}/contents/splash/images/wordmark.png"

  # --- wallpaper -----------------------------------------------------------------------
  local wall="${pkgdir}/usr/share/wallpapers/PocknixOS"
  install -Dm644 "${srcdir}/wallpaper-metadata.json"    "${wall}/metadata.json"
  install -Dm644 "${srcdir}/wallpaper-1920x1080.png"    "${wall}/contents/images/1920x1080.png"

  # --- first-login wallpaper seed ------------------------------------------------------
  install -Dm755 "${srcdir}/pocknix-branding-init" "${pkgdir}/usr/bin/pocknix-branding-init"
  install -Dm644 "${srcdir}/pocknix-branding-init.service" \
    "${pkgdir}/usr/lib/systemd/user/pocknix-branding-init.service"
  install -d "${pkgdir}/usr/lib/systemd/user/plasma-plasmashell.service.wants"
  ln -s ../pocknix-branding-init.service \
    "${pkgdir}/usr/lib/systemd/user/plasma-plasmashell.service.wants/pocknix-branding-init.service"
}
