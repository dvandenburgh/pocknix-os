# Makes a kernel pacman transaction on the device a complete deploy; no-ops in the image-build
# chroot, where the deploy script finds no mounted /flash.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = boot/Image
Target = boot/dtbs/*
Target = usr/lib/modules/*

[Action]
Description = pocknix: deploying the kernel to /flash...
When = PostTransaction
Exec = /usr/lib/pocknix/pocknix-boot-deploy
