# Pre-0.1.0-5 the fan/scheduler daemons shipped as unowned overlay files. /etc units shadow
# the packaged /usr/lib ones and the old enable symlinks point at /etc, so both must go.
_migrate_fan_lavd() {
  rm -f /usr/local/bin/pocknix-fancontrol /usr/local/bin/pocknix-fan-mode \
        /usr/local/bin/pocknix-lavd-mode \
        /etc/systemd/system/pocknix-fancontrol.service \
        /etc/systemd/system/pocknix-lavd.service \
        /etc/tmpfiles.d/pocknix-game-mode.conf
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/pocknix-game-mode.conf 2>/dev/null || true
    systemctl enable pocknix-fancontrol.service pocknix-lavd.service 2>/dev/null || true
    systemctl try-restart pocknix-fancontrol.service pocknix-lavd.service 2>/dev/null || true
  fi
}

# pocknix-powerd (an image overlay daemon) is retired: logind owns the power key. Nothing is
# stopped or reloaded: until the reboot that boots the patched kernel, the running powerd and
# logind's old setting are what keeps the wake press from re-suspending.
_retire_powerd() {
  rm -f /usr/local/bin/pocknix-powerd /etc/systemd/system/pocknix-powerd.service \
        /etc/systemd/system/multi-user.target.wants/pocknix-powerd.service
  [ -d /run/systemd/system ] && systemctl daemon-reload
  return 0
}

# Enabled by its wants symlink; restart picks up a new daemon or profile file without a reboot.
_perfd() {
  [ -d /run/systemd/system ] || return 0
  systemctl daemon-reload
  systemctl reload dbus.service 2>/dev/null || true
  systemctl restart pocknix-perfd.service 2>/dev/null || true
}

post_install() {
  _migrate_fan_lavd
  _retire_powerd
  _perfd
}

post_upgrade() {
  _migrate_fan_lavd
  _retire_powerd
  _perfd
}
