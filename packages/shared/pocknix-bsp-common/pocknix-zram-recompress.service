[Unit]
Description=Recompress idle zram pages with zstd
ConditionPathExists=/sys/block/zram0/recompress

[Service]
Type=oneshot
ExecStart=/usr/lib/pocknix/pocknix-zram-recompress
# Only spare CPU and I/O: the work runs in this process's context.
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
