# Opt-in until desktop Plasma and the base share one Plasma version. Build with ./nodeps:
# makepkg -s would drag all of KDE/Qt into the chroot for a data package.
pkgname=pocknix-desktop-plasma
pkgver=0.1.0
pkgrel=2
pkgdesc="pocknix desktop flavour: Plasma (desktop shell)"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
depends=('pocknix-desktop>=0.1.0-30'   # first picker that offers the plasma session
         'pocknix-desktop-kde>=0.1.0-3'  # owns the /etc/xdg/kwinrc that picks plasma-keyboard from -3
         'plasma-desktop'               # the org.kde.plasma.desktop shell; plasma.desktop alone is not enough
         'systemsettings'
         'kmenuedit'
         'polkit-kde-agent'
         'plasma-keyboard')
provides=('pocknix-desktop-flavour')

package() {
  :
}
