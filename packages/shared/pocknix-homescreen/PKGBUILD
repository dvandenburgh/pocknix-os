# Plasma Mobile boots to an empty, user-immutable homescreen. On the first Plasma Mobile login
# this puts the default apps on the dock and unlocks it; after that the layout is the user's.
pkgname=pocknix-homescreen
pkgver=0.1.0
pkgrel=1
pkgdesc="Plasma Mobile homescreen defaults: dock apps, unlocked, set once"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
depends=('bash' 'python' 'plasma-mobile')
source=('pocknix-homescreen-seed' 'pocknix-homescreen-init' 'pocknix-homescreen-init.service')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "${srcdir}/pocknix-homescreen-seed" "${pkgdir}/usr/bin/pocknix-homescreen-seed"
  install -Dm755 "${srcdir}/pocknix-homescreen-init" "${pkgdir}/usr/bin/pocknix-homescreen-init"
  local units="${pkgdir}/usr/lib/systemd/user"
  install -Dm644 "${srcdir}/pocknix-homescreen-init.service" "${units}/pocknix-homescreen-init.service"
  # Pulled in by the shell's own unit, as pocknix-branding does: --user units cannot be
  # enabled at install time, there is no user yet.
  install -d "${units}/plasma-plasmashell.service.wants"
  ln -s ../pocknix-homescreen-init.service "${units}/plasma-plasmashell.service.wants/pocknix-homescreen-init.service"
}
