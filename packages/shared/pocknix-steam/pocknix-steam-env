# pocknix-steam-env — sourced by both Steam launchers. Pins every game launch to the board's big
# cores via Valve's steam-launch-wrapper (shortcuts included), and gives Wine a CPU topology over
# the same cores: a topology that disagrees with the pin shows the game CPUs it may not use.
# Values already in the env win. No guessed fallback: a board without the key is not pinned.
. /usr/lib/pocknix/cores.sh
_pocknix_list="$(pocknix_big_cores)"
if [ -n "${_pocknix_list}" ]; then
  _pocknix_topology="$(printf '%s' "${_pocknix_list}" | awk -F, '{ print NF }'):${_pocknix_list}"
  export STEAM_LAUNCH_WRAPPER_AFFINITY_LIST="${STEAM_LAUNCH_WRAPPER_AFFINITY_LIST:-$(pocknix_cores_mask "${_pocknix_list}")}"
  export WINE_CPU_TOPOLOGY="${WINE_CPU_TOPOLOGY:-${_pocknix_topology}}"
  export PROTON_CPU_TOPOLOGY="${PROTON_CPU_TOPOLOGY:-${_pocknix_topology}}"
fi
unset _pocknix_list _pocknix_topology
