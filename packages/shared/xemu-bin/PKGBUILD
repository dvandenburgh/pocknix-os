# xemu-bin — xemu, the original-Xbox emulator, vendored from upstream's first-party aarch64
# Linux AppImage.
pkgname=xemu-bin
pkgver=0.8.136
pkgrel=4.1
pkgdesc="xemu — original Xbox emulator, official aarch64 AppImage (vendored)"
arch=('aarch64')
url="https://xemu.app"
license=('GPL2')
depends=('fuse2')
options=('!strip')
source=("xemu-${pkgver}.AppImage::https://github.com/xemu-project/xemu/releases/download/v${pkgver}/xemu-${pkgver}-aarch64.AppImage"
        'pocknix-xemu.desktop')
sha256sums=('8d2598bab0680ddd36c2d15ecccb70523e29adb852cd75e35bc5943dc0eb4816'
            'SKIP')
noextract=("xemu-${pkgver}.AppImage")

# The icon comes from the AppImage's own --appimage-extract (no FUSE needed). Run as is it would
# fail on an x86 build host: the chroot reaches aarch64 code through qemu's binfmt rule, which
# needs ELF header bytes 8-10 zero, and an AppImage keeps its "AI\2" marker there. A copy with
# the marker cleared runs; the runtime never reads it back.
_appimage_icon() {  # <AppImage> <out>: the file its .DirIcon resolves to
  local run="${srcdir}/.appimage-run" root=squashfs-root t=.DirIcon l n=0
  cp "$1" "${run}"
  printf '\0\0\0' | dd of="${run}" bs=1 seek=8 conv=notrunc status=none
  chmod u+x "${run}"
  rm -rf squashfs-root AppDir
  "${run}" --appimage-extract "${t}" >/dev/null 2>&1 || true
  [ -d AppDir ] && root=AppDir
  while [ -L "${root}/${t}" ] && [ "${n}" -lt 8 ]; do
    l="$(readlink "${root}/${t}")"
    case "${l}" in /*) t="${l#/}" ;; *) t="$(dirname "${t}")/${l}"; t="${t#./}" ;; esac
    "${run}" --appimage-extract "${t}" >/dev/null 2>&1 || true
    n=$((n + 1))
  done
  rm -f "${run}"
  cp -L "${root}/${t}" "$2" && [ -s "$2" ]   # fails the build if the icon vanished upstream
}

prepare() {
  cd "${srcdir}"
  _appimage_icon "xemu-${pkgver}.AppImage" "${srcdir}/icon.svg"
}

package() {
  install -Dm755 "${srcdir}/xemu-${pkgver}.AppImage" \
    "${pkgdir}/opt/pocknix/emulators/xemu/xemu.AppImage"
  install -Dm644 "${srcdir}/icon.svg" "${pkgdir}/opt/pocknix/emulators/xemu/icon.svg"
  install -Dm644 "${srcdir}/pocknix-xemu.desktop" "${pkgdir}/usr/share/applications/pocknix-xemu.desktop"
}
